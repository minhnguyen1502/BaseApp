<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_license_agreement"
    android:padding="24dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand_bold_700"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/noti_enable_title_ver_2"
        android:textColor="@color/text_high_em"
        android:textSize="18sp"
        tools:text="Allow IPTV Player to send you notifications" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/quicksand_medium_500"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/noti_enable_desc_ver_2"
        android:textColor="@color/text_low_em"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnDeny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_corner_100"
            android:backgroundTint="@color/white_6"
            android:fontFamily="@font/quicksand_semi_bold_600"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/deny"
            android:textColor="@color/text_high_em"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnAllow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_gradient_add_profile"
            android:fontFamily="@font/quicksand_semi_bold_600"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/allow"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
