<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/ac_corner_12"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/viewImage"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:backgroundTint="@color/transparent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintTop_toTopOf="parent">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/imageHabit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_habit_1"
            app:riv_corner_radius="8dp" />
    </FrameLayout>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvHabitsName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/quicksand_medium_500"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:lines="1"
        android:maxLines="1"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/viewImage"
        tools:text="Car" />

</androidx.constraintlayout.widget.ConstraintLayout>