<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/ac_bg_lang"
    android:gravity="center_vertical"
    android:padding="16dp"
    tools:ignore="RtlSymmetry">


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLanguageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/quicksand_bold_700"
        android:layoutDirection="ltr"
        android:text="adsasdasd"
        android:textAlignment="viewStart"
        android:textColor="@color/text_high_em"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLanguage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/quicksand_medium_500"
        android:layoutDirection="ltr"
        android:text="adsasdasd"
        android:textAlignment="viewEnd"
        android:textColor="@color/text_high_em"
        android:textSize="14sp" />

</androidx.appcompat.widget.LinearLayoutCompat>