<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?colorControlHighlight">
    <item android:id="@android:id/background">
        <layer-list>
            <!-- Layer bottom border (màu border) -->
            <item>
                <shape>
                    <gradient
                        android:endColor="#0ACDE3"
                        android:startColor="#6F61FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape>
                    <solid android:color="@color/surface_s2" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>