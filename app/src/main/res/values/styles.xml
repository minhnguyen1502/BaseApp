<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TabTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/quicksand_semi_bold_600</item>
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="WcFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_filter</item>
        <item name="android:fontFamily">@font/quicksand_semi_bold_600</item>
        <item name="android:textColor">@color/ac_text_filter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <!-- styles.xml -->
    <style name="FilterChipText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_filter</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lines">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">@font/quicksand_semi_bold_600</item>
        <item name="android:textColor">@color/ac_text_filter</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>